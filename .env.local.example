# Copy sang .env.local rồi điền. Lấy giá trị thật bằng:
#     npm run db:env
# (hoặc: npx supabase status -o env)
#
# Dự án này chạy Supabase local ở dải port 553xx để không đụng stack Web_Update:
#   API     http://127.0.0.1:55321
#   DB      postgresql://postgres:postgres@127.0.0.1:55322/postgres
#   Studio  http://127.0.0.1:55323

VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=
