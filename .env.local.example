# Copy sang .env.local rồi điền. Lấy giá trị thật bằng:
#     npm run db:env
# (hoặc: npx supabase status -o env)
#
# Dự án này chạy Supabase local ở dải port 553xx để không đụng stack Web_Update:
#   API     http://127.0.0.1:55321
#   DB      postgresql://postgres:postgres@127.0.0.1:55322/postgres
#   Studio  http://127.0.0.1:55323

VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=

# Web Push (PWA). Sinh cặp khoá: npx web-push generate-vapid-keys
#   - PUBLIC key  -> biến dưới đây, VÀ biến môi trường của Vercel.
#     Vite nhúng biến này lúc BUILD, không đọc lúc chạy: thiếu ở Vercel là bản deploy
#     mang giá trị rỗng, bật thông báo sẽ báo lỗi dù máy local vẫn chạy tốt.
#   - PRIVATE key -> supabase secrets set VAPID_PRIVATE_KEY=...
#     (kèm VAPID_PUBLIC_KEY và VAPID_SUBJECT=mailto:... cho Edge Function push-send)
#   Hai bên PHẢI cùng một cặp. Đổi khoá thì mọi subscription cũ thành rác — xoá sạch
#   bảng `push_subscriptions` và cho mọi người bật lại.
VITE_VAPID_PUBLIC_KEY=
